# App routing (required for polygonplast.ru/calculator)
NEXT_PUBLIC_BASE_PATH=/calculator
NEXT_PUBLIC_API_URL=/calculator/api

# Bind containers only on localhost in production
WEB_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1
REDIS_BIND_HOST=127.0.0.1

# Data source for API
REFERENCE_DATA_SOURCE=sheets
LOCAL_DATA_PATH=/app/data/reference_data.local.json
GOOGLE_SHEET_ID=your_google_sheet_id

# Redis inside docker network
REDIS_URL=redis://redis:6379

# Absolute path on server to Google service account key
# Example: /opt/calc1-prod/secrets/credentials.json
GOOGLE_CREDENTIALS_FILE=/absolute/path/to/credentials.json
