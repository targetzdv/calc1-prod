# Source mode for reference data:
# - local: only local JSON file
# - sheets: only Google Sheets
# - auto: Google Sheets with fallback to local JSON
REFERENCE_DATA_SOURCE=sheets

# Path to local JSON file (used in local/auto modes)
LOCAL_DATA_PATH=/app/data/reference_data.local.json

# Google Sheets API
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjGMUUqptbfs74NYvQEw

# Redis (если нужно переопределить)
REDIS_URL=redis://redis:6379
