# Source mode for reference data:
# - local: only local JSON file
# - sheets: only Google Sheets
# - auto: Google Sheets with fallback to local JSON
REFERENCE_DATA_SOURCE=sheets

# Path to local JSON file (used in local/auto modes)
LOCAL_DATA_PATH=/app/data/reference_data.local.json

# Google Sheets API
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjGMUUqptbfs74NYvQEw

# Redis (если нужно переопределить)
REDIS_URL=redis://redis:6379

# Container bind host IPs
WEB_BIND_HOST=0.0.0.0
API_BIND_HOST=0.0.0.0
REDIS_BIND_HOST=0.0.0.0

# Frontend routing (optional, required for deployment in subpath like /calculator)
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_URL=/api

# Absolute path to Google credentials file on host (used by deploy/docker-compose.prod.yml)
GOOGLE_CREDENTIALS_FILE=./apps/api/credentials.json
